# Copy to .env.local and adjust to override. Never commit .env.local.

# Base URL of the ASP.NET Core API (backendS/). The Next dev server proxies
# /api/* to this origin so the browser only ever talks same-origin (no CORS).
# Default matches the backend exposed by backendS/docker-compose.yml (API_PORT_1).
API_BASE_URL=http://localhost:8080